<section id="contacto" class="contact-section">
  <div class="container">
    <div class="info-box">
      <h2>Hablemos</h2>
      <p>
        Estamos listos para asesorarte. Dejanos tus datos y nos pondremos en
        contacto a la brevedad.
      </p>

      <div class="contact-details">
        <div class="detail-item">
          <strong>📍 Oficina:</strong>
          <span
            ><a
              href="https://maps.app.goo.gl/rwFx5cmB1NpAuwpw5"
              target="_blank"
              rel="noopener noreferrer"
              class="link-direccion"
            >
              Montañeses 1892 Belgrano</a
            ></span
          >
        </div>
        <div class="detail-item">
          <strong>📧 Email:</strong>
          <a href="mailto:silberteguros@barter-group.com" class="link-direccion"
            >silberteguros@barter-group.com</a
          >
        </div>
        <div class="detail-item">
          <strong>📞 Teléfono:</strong>
          <span>+54 9 11 5877-8821 Pamela Weidgans</span>
        </div>
        <div class="detail-item">
          <strong>🕒 Horario:</strong>
          <span>Lun a Vie de 10:00 a 16:30hs</span>
        </div>
      </div>
    </div>

    <div class="form-box">
      <form id="contactForm">
        <div class="form-group">
          <label for="nombre">Nombre Completo</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            placeholder="Ej: Juan Pérez"
            required
          />
        </div>

        <div class="form-group">
          <label for="telefono">Teléfono / Celular</label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            placeholder="Ej: 11 1234 5678"
            required
          />
        </div>

        <div class="form-group">
          <label for="interes">Me interesa cotizar:</label>
          <select id="interes" name="interes">
            <option value="Automotor">Automotor Particular</option>
            <option value="Flotas">Flotas Comerciales</option>
            <option value="Motos">Motos</option>
            <option value="Hogar">Hogar & Combinado</option>
            <option value="Comercio">Integral de Comercio</option>
            <option value="ART">ART / Accidentes</option>
            <option value="Caucion">Caución / Garantías</option>
            <option value="Agro">Agro / Silobolsa</option>
            <option value="Vida">Vida / Retiro</option>
            <option value="RC">Responsabilidad Civil</option>
            <option value="AP">Accidentes Personales</option>
            <option value="Transporte">Transporte de Cargas</option>
            <option value="Otro">Otra consulta</option>
          </select>
        </div>

        <div class="form-group">
          <label for="mensaje">Datos Adicionales (Opcional)</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="4"
            placeholder="Por favor indícanos: Marca, Modelo y Año del vehículo."
          ></textarea>
        </div>

        <button type="submit" class="btn-submit">ENVIAR CONSULTA</button>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const selector = document.getElementById("interes") as HTMLSelectElement;
    const mensajeArea = document.getElementById(
      "mensaje",
    ) as HTMLTextAreaElement;

    const ayudas: any = {
      Automotor: "Por favor indícanos: Marca, Modelo y Año del vehículo.",
      Motos: "Por favor indícanos: Marca, Cilindrada y Año.",
      Hogar: "¿Es casa o departamento? ¿Metros cuadrados aproximados?",
      Vida: "¿Qué edad tienes y qué capital te gustaría asegurar?",
      ART: "¿Cuántos empleados tiene la nómina aproximadamente?",
      Otro: "Cuéntanos brevemente en qué podemos ayudarte.",
    };

    function actualizarAyuda() {
      // Chequeo de seguridad por si el elemento no cargó
      if (!selector || !mensajeArea) return;

      const seleccion = selector.value;
      mensajeArea.placeholder =
        ayudas[seleccion] ||
        "Cuéntanos más detalles para poder asesorarte mejor.";
    }

    if (selector) {
      selector.addEventListener("change", actualizarAyuda);
    }

    // --- LÓGICA DE PARÁMETROS URL ---
    const params = new URLSearchParams(window.location.search);
    const tema = params.get("tema");

    if (tema && selector) {
      const opciones: any = {
        auto: "Automotor",
        flotas: "Flotas",
        motos: "Motos",
        hogar: "Hogar",
        comercio: "Comercio",
        art: "ART",
        caucion: "Caucion",
        agro: "Agro",
        vida: "Vida",
        rc: "RC",
        ap: "AP",
        transporte: "Transporte",
      };

      // Ahora podemos verificar si existe sin errores rojos
      if (opciones[tema]) {
        selector.value = opciones[tema];
        actualizarAyuda();
      }
    }

    // --- RESTRICCIÓN DE INPUT TELÉFONO ---
    const telefonoField = document.getElementById(
      "telefono",
    ) as HTMLInputElement;
    if (telefonoField) {
      telefonoField.addEventListener("input", function () {
        // Reemplaza en tiempo real cualquier carácter que no sea número, espacio, + o -
        this.value = this.value.replace(/[^0-9+\s-]/g, "");
      });
    }

    // --- ENVÍO A WHATSAPP ---
    const form = document.getElementById("contactForm");

    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();

        // Obtenemos valores asegurándonos del tipo de elemento y aplicamos sanitización
        const nombreInput = document.getElementById(
          "nombre",
        ) as HTMLInputElement;
        const telefonoInput = document.getElementById(
          "telefono",
        ) as HTMLInputElement;
        const interesInput = document.getElementById(
          "interes",
        ) as HTMLSelectElement;
        const mensajeInput = document.getElementById(
          "mensaje",
        ) as HTMLTextAreaElement;

        let nombre = nombreInput.value.trim();
        let telefono = telefonoInput.value.trim();
        const interes = interesInput.value;
        let mensaje = mensajeInput.value.trim();

        // Sanitización básica (evitar inyección de HTML o caracteres extraños en el texto)
        nombre = nombre.replace(/</g, "&lt;").replace(/>/g, "&gt;");
        telefono = telefono.replace(/[^0-9+\s-]/g, "");
        mensaje = mensaje.replace(/</g, "&lt;").replace(/>/g, "&gt;");

        const telefonoDestino = "5491158778821";

        let texto = `Hola Pamela, soy ${nombre}. Consulto por *${interes}*. `;
        texto += `Mi teléfono es ${telefono}. `;
        if (mensaje) texto += `Detalles: ${mensaje}`;

        const url = `https://wa.me/${telefonoDestino}?text=${encodeURIComponent(texto)}`;

        window.open(url, "_blank");
      });
    }
  });
</script>

<style>
  .contact-section {
    padding: 0.5rem 0;
    background-color: white;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 50px;
  }

  .info-box {
    flex: 1;
    min-width: 300px;
  }

  .info-box h2 {
    color: #003366;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .info-box p {
    color: #666;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .detail-item {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .detail-item strong {
    color: #003366;
    margin-bottom: 0.3rem;
  }

  .form-box {
    flex: 1;
    min-width: 300px;
    background-color: #e1ebf5ff;
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    color: #003366;
    font-weight: bold;
    font-size: 0.9rem;
  }

  input[type="text"],
  input[type="tel"],
  select,
  textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-family: inherit;
    font-size: 1rem;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.2s ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: #003366;
    box-shadow: 0 0 0 4px rgba(0, 51, 102, 0.15);
    transform: translateY(-2px);
  }

  .btn-submit {
    width: 100%;
    padding: 15px;
    background-color: #d13e00;
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      transform 0.2s ease,
      box-shadow 0.3s ease;
  }

  .btn-submit:hover {
    background-color: #e03e00;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(224, 62, 0, 0.3);
  }

  .link-direccion {
    color: black;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-direccion:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column;
    }
  }
</style>
