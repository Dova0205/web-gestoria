---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-col">
      <h3>SILBERT <span class="highlight">SEGUROS</span></h3>
      <p>
        Asesoramiento integral con más de 30 años de trayectoria en el mercado
        asegurador. Protegemos tu patrimonio y tu futuro.
      </p>
    </div>

    <div class="footer-col">
      <h4>Navegación</h4>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/#servicios">Servicios</a></li>
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/asistencia">SOS / Asistencia</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contacto</h4>
      <p>
        📍 <a
          href="https://maps.app.goo.gl/rwFx5cmB1NpAuwpw5"
          target="_blank"
          rel="noopener noreferrer"
          class="link-direccion"
        >
          Montañeses 1892 Belgrano</a
        >
      </p>
      <p>
        <a href="tel:++54 9 11 5877-8821" class="link-direccion"
          >📞 +54 9 11 5877-8821 Pamela Weidgans</a
        >
      </p>
      <p>
        <a href="mailto:silberteguros@barter-group.com" class="link-direccion"
          >📧 silberteguros@barter-group.com</a
        >
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} Silbert Seguros. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #002244;
    color: #e0e0e0;
    padding-top: 4rem;
    font-size: 0.95rem;
  }

  .container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    padding-bottom: 3rem;
  }

  h3 {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .highlight {
    color: #ff4500;
  }

  h4 {
    color: white;
    margin-bottom: 1.2rem;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .footer-col p {
    line-height: 1.6;
    margin-bottom: 0.5rem;
    color: #b0c4de;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col ul li {
    margin-bottom: 0.8rem;
  }

  .footer-col ul li a {
    color: #b0c4de;
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-col ul li a:hover {
    color: #ff4500;
    padding-left: 5px;
  }

  .footer-bottom {
    background-color: #001a33;
    padding: 1.5rem 20px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    width: 100%;
    margin: 0 auto;
  }

  .link-direccion {
    color: #b0c4de;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-direccion:hover {
    text-decoration: underline;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }

    .container {
      padding: 0 30px;
    }
  }
</style>
